# Copy to `.env` and fill in. These keys are read ONLY on the server (src/lib/server/config.ts).
# Never prefix them with PUBLIC_ - that would expose them to the browser.

# https://openweathermap.org/api - current weather, reverse geocoding, map tiles
OPENWEATHER_API_KEY=
# https://unsplash.com/developers - place images
UNSPLASH_ACCESS_KEY=
# https://developer.tomtom.com/ - routing
TOMTOM_API_KEY=

# Global TomTom route requests per UTC day (best effort, per server instance). Default 600 (= 20,000 / 30).
TOMTOM_DAILY_BUDGET=

# Demo data for routes and current weather: "true" forces it, "false" disables it.
# Unset = demo data while TOMTOM_API_KEY or OPENWEATHER_API_KEY is missing.
MOCK_API=
