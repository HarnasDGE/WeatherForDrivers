---
import logo from '@/assets/logoweather.png';
import { USED_API } from '@/lib/shared/used-apis';
---

<footer>
  <div class="footer-column">
    <img src={logo.src} alt="Logo App" />
    <div class="pageTitle gradient-text">Weather App</div>
  </div>
  <div class="footer-column">
    <ul>
      <li>USED API</li>
      {
        USED_API.map((api) => (
          <li>
            <a href={api.url} target="_blank" rel="noopener noreferrer">
              <span class="api-list-title">{api.name}</span> <span class="api-list-desc">{api.desc}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="footer-column">
    <ul>
      <li>Services</li>
      <li>Main</li>
      <li>Maps</li>
      <li>Along The Road</li>
    </ul>
  </div>
  <div class="footer-column">
    <ul>
      <li>Thanks to</li>
      <li>Me &lt;3</li>
      <li>My Girlfriend</li>
      <li>Api Creators</li>
    </ul>
  </div>
</footer>
