---
import '@/styles/global.css';
import { STORAGE_KEY } from '@/store/persist';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Weather for Drivers',
  description = 'Weather along your route, timed to when you get there, plus a five-day forecast for any town.',
} = Astro.props;

// Only the icons the app uses (keeps the icon font small). Names must stay in alphabetical order.
const ICONS = [
  'air',
  'arrow_back',
  'bedtime',
  'bookmark',
  'brightness_auto',
  'check',
  'check_circle',
  'clear_day',
  'clear_night',
  'close',
  'cloud',
  'dark_mode',
  'delete',
  'directions_car',
  'error',
  'foggy',
  'info',
  'light_mode',
  'location_on',
  'partly_cloudy_day',
  'partly_cloudy_night',
  'question_mark',
  'radar',
  'rainy',
  'rainy_heavy',
  'rainy_light',
  'rainy_snow',
  'refresh',
  'schedule',
  'search',
  'snowing_heavy',
  'swap_vert',
  'thunderstorm',
  'umbrella',
  'visibility',
  'warning',
  'wb_sunny',
  'wb_twilight',
  'weather_snowy',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <meta name="theme-color" content="#ffffff" />
    <!-- Pick the saved / system theme before first paint (the React app keeps it in sync afterwards). -->
    <script is:inline define:vars={{ storageKey: STORAGE_KEY }}>
      let preference = 'system';
      try {
        preference = JSON.parse(localStorage.getItem(storageKey) || '{}').ui?.theme || 'system';
      } catch {}
      const dark = preference === 'dark' || (preference === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    </script>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Overpass:wght@400;600;800&display=swap" />
    <link
      rel="stylesheet"
      href={`https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,500,0..1,0&icon_names=${ICONS.join(',')}&display=block`}
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
